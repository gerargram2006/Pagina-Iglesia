# Copy this file to .env and replace every placeholder before starting the API.
DB_HOST=127.0.0.1
DB_PORT=33007
DB_USER=iglesia_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=iglesia_db

# API port
PORT=3307

# Generate a long, random value for production.
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed frontend origins. Never use * in production.
CORS_ORIGIN=http://localhost:5173
